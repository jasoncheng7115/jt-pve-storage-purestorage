#!/bin/bash
set -e

MULTIPATH_CONF="/etc/multipath.conf"

# ANSI colors
RED='\033[0;31m'
YEL='\033[0;33m'
GRN='\033[0;32m'
BLU='\033[0;34m'
RST='\033[0m'

print_safety_warning() {
    cat <<'BANNER'

==============================================================================
 Pure Storage Plugin: CRITICAL Multipath Safety Rules
==============================================================================
 1. NEVER run `multipath -F` (capital F). It flushes ALL unused multipath
    maps system-wide. In a mixed environment this will disconnect any
    storage that is currently idle, including non-Pure storage. Always use
    lowercase `multipath -f /dev/mapper/<wwid>` to flush a specific map.

 2. To reload multipath configuration after editing /etc/multipath.conf,
    use `systemctl restart multipathd` — NOT `systemctl reload multipathd`.
    Reload only re-reads the file; restart actually reapplies device-mapper
    state. The plugin uses restart in its own helpers for the same reason.

 3. Recommended Pure-friendly multipath.conf settings:
        path_selector       "queue-length 0"
        path_grouping_policy group_by_prio
        prio                alua
        hardware_handler    "1 alua"
        failback            immediate
        no_path_retry       30
        fast_io_fail_tmo    5
        dev_loss_tmo        60

 4. AVOID `no_path_retry queue` and `dev_loss_tmo infinity` for Pure devices.
    Combined with stale device residue they can put PVE daemons into
    uninterruptible sleep and require a node reboot.
==============================================================================
BANNER
}

# Detect dangerous multipath settings, AND report which scope each one is in.
#
# A flat grep over multipath.conf is wrong: `no_path_retry queue` inside a
# `device { vendor "NETAPP" ... }` block applies only to NetApp LUNs and has no
# effect whatsoever on Pure devices, yet the previous flat grep reported it as
# a Pure hazard. That cries wolf, and worse, it can push an operator into
# "fixing" another vendor's recommended configuration.
#
# Scope rules:
#   defaults { }            -> applies to Pure devices unless a device block
#                              overrides it. Real hazard: warn.
#   device { vendor PURE }  -> applies directly to Pure. Real hazard: warn.
#   device { vendor OTHER } -> does not affect Pure. Same hazard class for that
#                              vendor's LUNs on a PVE node, so mention it as a
#                              note, not as a Pure warning.
#   multipaths { }          -> per-WWID; report with the scope named so the
#                              operator can judge.
scan_multipath_scopes() {
    awk '
        function emit(setting) {
            printf "%s\t%s\n", scope, setting
        }
        /^[[:space:]]*defaults[[:space:]]*\{/  { scope="defaults"; next }
        /^[[:space:]]*multipaths[[:space:]]*\{/ { scope="multipaths"; next }
        /^[[:space:]]*device[[:space:]]*\{/    { scope="device:?"; next }
        /^[[:space:]]*vendor[[:space:]]+/ {
            v=$2; gsub(/"/,"",v)
            if (scope ~ /^device/) scope="device:" v
            next
        }
        /^[[:space:]]*\}/ { if (scope ~ /^device/) scope="devices"; else scope=""; next }
        /^[[:space:]]*no_path_retry[[:space:]]+queue([[:space:]]|$)/ { emit("no_path_retry queue") }
        /^[[:space:]]*queue_if_no_path([[:space:]]|$)/               { emit("queue_if_no_path") }
        /^[[:space:]]*dev_loss_tmo[[:space:]]+infinity([[:space:]]|$)/ { emit("dev_loss_tmo infinity") }
    ' "$1"
}

detect_dangerous_multipath_settings() {
    [ -f "$MULTIPATH_CONF" ] || return 0
    command -v awk >/dev/null 2>&1 || return 0

    local found=0
    local hits=""
    local notes=""
    local scope setting line

    while IFS=$'\t' read -r scope setting; do
        [ -n "$setting" ] || continue
        case "$scope" in
            defaults)
                hits+="  - $setting (in the 'defaults' section of $MULTIPATH_CONF)\n"
                found=1
                ;;
            device:PURE|device:Pure|device:pure)
                hits+="  - $setting (in the PURE device block of $MULTIPATH_CONF)\n"
                found=1
                ;;
            device:*)
                notes+="  - $setting (scoped to ${scope#device:} devices in $MULTIPATH_CONF)\n"
                ;;
            *)
                notes+="  - $setting (in the '${scope:-unknown}' scope of $MULTIPATH_CONF)\n"
                ;;
        esac
    done <<EOSCAN
$(scan_multipath_scopes "$MULTIPATH_CONF")
EOSCAN

    if [ -n "$notes" ]; then
        cat <<'EOF'

------------------------------------------------------------------------------
 NOTE: risky multipath settings found, but NOT applied to Pure devices
------------------------------------------------------------------------------
 These are scoped to another vendor's device block, so they do not affect
 this plugin. They carry the same hang risk for that vendor's LUNs on a
 Proxmox VE node, so they are reported for awareness only — no action is
 required for Pure Storage:

EOF
        printf "$notes"
        cat <<'EOF'
------------------------------------------------------------------------------

EOF
    fi

    if [ "$found" = "1" ]; then
        printf "${RED}"
        cat <<EOF

==============================================================================
 DANGEROUS MULTIPATH SETTINGS DETECTED
==============================================================================
 The following settings can put PVE into an unrecoverable hang when a Pure
 LUN is deleted on the array but still has stale local devices:

EOF
        printf "$hits"
        cat <<'EOF'

 Recommended replacements:
   no_path_retry 30
   fast_io_fail_tmo 5
   dev_loss_tmo 60

 The plugin will NOT modify your /etc/multipath.conf automatically. Please
 review and adjust manually, then run:
   systemctl restart multipathd      # restart, NOT reload
==============================================================================

EOF
        printf "${RST}"
    fi
}

detect_stale_pure_devices() {
    command -v multipath >/dev/null 2>&1 || return 0
    command -v awk >/dev/null 2>&1 || return 0

    # `multipath -ll` itself can hang; bound it.
    local out
    out=$(timeout 15 multipath -ll 2>/dev/null) || return 0

    # Parse blocks: a map line like "3624a9370abcdef0 dm-3 PURE,FlashArray ..."
    # followed by indented path lines whose status fields show 'failed' or
    # 'faulty'. We list maps where every path is failed/faulty.
    local stale
    stale=$(echo "$out" | awk '
        /^[a-z0-9]+ dm-[0-9]+ PURE/ {
            if (name && pathcount > 0 && pathcount == failcount) {
                print name
            }
            name=$1; pathcount=0; failcount=0; next
        }
        /[ \t]+(active|failed|faulty)[ \t]+(ready|faulty|ghost|shaky)/ {
            pathcount++
            if ($0 ~ /(failed|faulty)[ \t]+(faulty|shaky)/) failcount++
            if ($0 ~ /failed[ \t]+ready/) failcount++
        }
        END {
            if (name && pathcount > 0 && pathcount == failcount) print name
        }
    ')

    if [ -n "$stale" ]; then
        printf "${YEL}"
        cat <<'EOF'

==============================================================================
 STALE PURE MULTIPATH DEVICES DETECTED
==============================================================================
 The following Pure multipath devices have all paths failed. They may be
 leftover residue from a deleted volume on a previous plugin version that
 did not perform cluster-wide WWID cleanup:

EOF
        echo "$stale" | sed 's/^/  - /'
        cat <<'EOF'

 The plugin will NOT auto-clean these because they could be from
 manually-attached LUNs or other plugins. To remove a stale device safely:

   multipathd disablequeueing map <wwid>
   dmsetup message <wwid> 0 fail_if_no_path
   multipath -f /dev/mapper/<wwid>
   # if multipath -f fails:
   dmsetup remove --force --retry <wwid>

 Once this plugin (v1.1.0+) is active, the orphan-cleanup pass in status()
 will pick up any future stale devices automatically.
==============================================================================

EOF
        printf "${RST}"
    fi
}

detect_missing_lvm_global_filter() {
    local LVMCONF="/etc/lvm/lvm.conf"
    [ -f "$LVMCONF" ] || return 0

    # Check if global_filter is set (uncommented, with at least one rule).
    if grep -Eq '^\s*global_filter\s*=' "$LVMCONF"; then
        return 0
    fi

    printf "${YEL}"
    cat <<'EOF'

==============================================================================
 MISSING LVM global_filter — HOST LVM MAY ACTIVATE GUEST VGs
==============================================================================
 Your /etc/lvm/lvm.conf does not have a `global_filter` setting. This is
 common on PVE nodes upgraded from earlier versions (7 -> 8 -> 9). Without
 it, the host's LVM scanner (vgscan/pvscan) reads ALL block devices
 including Pure-managed multipath LUNs, and may auto-activate VGs that
 exist INSIDE guest VM disks. These activated VGs appear as "holders" on
 the multipath device, which prevents the plugin from deleting the volume.

 The symptoms are:
   - `pvesm free` fails with "device is still in use (has holders)"
   - `vgs` / `pvs` shows duplicate VG name warnings
   - /sys/block/<dm-N>/holders/ has unexpected dm-* entries

 Recommended fix: add the following to /etc/lvm/lvm.conf under the
 `devices { }` section:

     global_filter = [ "r|/dev/mapper/360.*|", "r|/dev/dm-.*|", "a|.*|" ]

 This rejects Pure (and other SAN) multipath devices from LVM scanning
 while allowing everything else. After editing:

     vgchange -an <guest_vg_name>    # deactivate any already-activated guest VGs
     systemctl restart lvm2-monitor
     vgscan --cache

 Fresh PVE 9 installs already have this filter. Upgraded nodes do not.
==============================================================================

EOF
    printf "${RST}"
}

warn_inflight_operations() {
    # Detect storage-affecting operations that may be in flight before we
    # reload the PVE services (NetApp v0.2.10 parity). `systemctl reload` is a
    # graceful SIGHUP re-exec and does NOT abort running workers, so this is a
    # courtesy heads-up rather than a hard block: it gives the operator a brief
    # window to defer the reload if a long migration/backup is running.
    local hits
    hits=$(pgrep -af 'qmrestore|vzdump|qm +(move-disk|move_disk|clone|migrate|importdisk)|pvesm +(alloc|free|import|export|extractconfig)' 2>/dev/null \
        | grep -Ev 'pgrep|warn_inflight_operations' || true)
    if [ -n "$hits" ]; then
        echo ""
        echo "  [NOTICE] Storage-affecting operations appear to be in flight:"
        echo "$hits" | sed 's/^/      /'
        echo "  Reloading PVE services now (graceful SIGHUP — these operations are NOT aborted)."
        echo "  Press Ctrl-C within 5 seconds to skip and reload later with:"
        echo "      systemctl reload pvedaemon pvestatd pveproxy"
        sleep 5
    fi
}

reload_pve_services() {
    # PVE services load Perl plugin modules at startup and keep them in
    # memory (shared via COW in forked workers). Installing new .pm files
    # does NOT affect running services — they must be reloaded.
    #
    # Three services load storage plugins:
    #   pvedaemon  — qm/pvesm operations
    #   pvestatd   — periodic status() polling every ~10 seconds
    #   pveproxy   — web UI API
    #
    # Use `systemctl reload` (SIGHUP → PVE::Daemon re-exec) instead of
    # `restart` (stop+start). If the old code created D-state children
    # (e.g. from the pre-1.1.5 scsi_host scan bug on HPE hardware), the
    # stop phase hangs waiting for unkillable D-state children. reload
    # bypasses the stop phase entirely.
    #
    # If a service is not running (e.g. fresh install), use `start`.

    # $1 here is the previously-configured version (empty on fresh install,
    # non-empty on upgrade) — passed through from the `configure` case.
    local old_version="$1"

    for svc in pvedaemon pvestatd pveproxy; do
        if timeout 5 systemctl is-active --quiet "$svc" 2>/dev/null; then
            timeout 30 systemctl reload "$svc" 2>/dev/null || \
                echo "  [WARN] Could not reload $svc (D-state children from old code?)"
        else
            timeout 30 systemctl start "$svc" 2>/dev/null || true
        fi
    done
    echo "PVE services reloaded to pick up new plugin code."

    # CRITICAL upgrade caveat: `systemctl reload` (SIGHUP → PVE::Daemon
    # re-exec) does NOT reliably reload the plugin's Perl modules on many PVE
    # versions — pvestatd can keep running the OLD code in memory even though
    # the new .pm files are on disk. We deliberately use reload (not restart)
    # to avoid the stop-phase hang on D-state children, but that means the
    # operator MUST restart pvestatd to actually activate new code. Only
    # surface this on an upgrade (fresh installs have no stale code to clear).
    if [ -n "$old_version" ]; then
        # ANSI yellow if writing to a terminal, plain otherwise.
        local Y="" N=""
        if [ -t 1 ]; then Y=$'\033[1;33m'; N=$'\033[0m'; fi
        cat <<EOF

${Y}==============================================================================
 ACTION REQUIRED AFTER THIS UPGRADE (every cluster node)
==============================================================================${N}
 The plugin files were updated and PVE services were reloaded (SIGHUP), but
 on many PVE versions reload does NOT reload Perl modules — pvestatd may keep
 running the OLD plugin code from memory. To actually activate ${old_version:+the new }code:

     systemctl restart pvestatd

 Run this on EVERY node in the cluster. To verify the restart took effect,
 confirm the MainPID changed:

     systemctl show -p MainPID pvestatd     # before and after — PID MUST change

 We intentionally use reload (not auto-restart) in this package to avoid the
 stop-phase hang on D-state children left by very old code; the manual
 restart above is the safe way to load the new code.
${Y}==============================================================================${N}
EOF
    fi
}

verify_required_binaries() {
    # Issue #9: when a user installs the .deb via `dpkg -i` (rather than
    # `apt install ./*.deb`), dpkg does NOT auto-install the declared
    # dependencies. The plugin's Perl modules land on disk fine, but
    # operations that shell out to multipathd / iscsiadm / kpartx fail
    # later with "No such file or directory" — exposing internal Perl
    # paths in the user-facing error. Catch this at install time
    # instead and direct the operator at the canonical fix.
    local missing=()
    local needed_bin=(multipathd multipath kpartx iscsiadm sg_inq blockdev fuser)
    local b

    for b in "${needed_bin[@]}"; do
        command -v "$b" >/dev/null 2>&1 || missing+=("$b")
    done

    if [ ${#missing[@]} -gt 0 ]; then
        cat <<EOF >&2

==============================================================================
 ERROR: Required binaries are not installed on this system
==============================================================================
 The Pure Storage plugin needs the following binaries which are not on PATH:

EOF
        printf '   - %s\n' "${missing[@]}" >&2
        cat <<'EOF' >&2

 These come from packages declared as dependencies by this .deb:
   - multipath-tools  (provides multipath, multipathd, kpartx)
   - open-iscsi       (provides iscsiadm)
   - sg3-utils        (provides sg_inq)
   - util-linux       (provides blockdev)

 If you installed with `dpkg -i ...`, dpkg does not auto-install
 dependencies. Recover with:

   apt --fix-broken install

 Or re-install with apt instead (recommended), which resolves
 dependencies automatically:

   apt install ./jt-pve-storage-purestorage_*_all.deb

 This package will remain in configured-failed state until the
 missing binaries are installed.
==============================================================================

EOF
        return 1
    fi
    return 0
}

case "$1" in
    configure)
        if ! verify_required_binaries; then
            exit 1
        fi

        echo "Pure Storage FlashArray Plugin installed successfully."
        echo ""
        echo "To configure, add storage with:"
        echo "  pvesm add purestorage <storage-id> \\"
        echo "    --pure-portal <pure-array-ip> \\"
        echo "    --pure-api-token <api-token> \\"
        echo "    --content images"
        echo ""
        echo "Or with username/password:"
        echo "  pvesm add purestorage <storage-id> \\"
        echo "    --pure-portal <pure-array-ip> \\"
        echo "    --pure-username <user> \\"
        echo "    --pure-password <password> \\"
        echo "    --content images"
        echo ""
        echo "See /usr/share/doc/jt-pve-storage-purestorage/README.md for details."

        # Ensure required services are enabled (with timeout to prevent hang)
        if timeout 5 systemctl is-active --quiet iscsid 2>/dev/null; then
            echo "iSCSI initiator daemon is running."
        else
            echo "NOTE: iscsid service is not running. Starting..."
            timeout 10 systemctl enable iscsid 2>/dev/null || true
            timeout 10 systemctl start iscsid 2>/dev/null || true
        fi

        if timeout 5 systemctl is-active --quiet multipathd 2>/dev/null; then
            echo "Multipath daemon is running."
        else
            echo "NOTE: multipathd service is not running. Starting..."
            timeout 10 systemctl enable multipathd 2>/dev/null || true
            timeout 10 systemctl start multipathd 2>/dev/null || true
        fi

        # Create the WWID tracking state directories so the first status()
        # call doesn't have to.
        install -d -m 0700 /var/lib/pve-storage-purestorage 2>/dev/null || true
        install -d -m 0700 /var/run/pve-storage-purestorage 2>/dev/null || true

        print_safety_warning
        detect_dangerous_multipath_settings
        detect_stale_pure_devices
        detect_missing_lvm_global_filter
        warn_inflight_operations
        # $2 = previously-configured version on upgrade, empty on fresh install.
        reload_pve_services "$2"
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
